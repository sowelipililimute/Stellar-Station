<Control xmlns="https://spacestation14.io"
         xmlns:layout="clr-namespace:Content.Client._ES.UI.Controls.Layout">
    <layout:VStack StyleClasses="STInsetBox">
        <Label Text="xxProfile" StyleClasses="LabelHeading" />
        <layout:LowDivider />

        <layout:VStack StyleClasses="STInsetBox">
            <Label Text="xxName" HorizontalExpand="True" StyleClasses="STFieldLabel" />
            <LineEdit Name="ProfileName" MinWidth="80" HorizontalExpand="True" />
        </layout:VStack>

        <layout:VStack StyleClasses="STInsetBox">
            <Label Text="xxSpecies" HorizontalExpand="True" StyleClasses="STFieldLabel" />
            <WrapContainer HorizontalExpand="True" Name="SpeciesBox" />
        </layout:VStack>

        <layout:VStack StyleClasses="STInsetBox">
            <Label Text="xxAge" HorizontalExpand="True" StyleClasses="STFieldLabel" />
            <LineEdit Name="ProfileAge" HorizontalExpand="True" />
        </layout:VStack>

        <layout:VStack StyleClasses="STInsetBox">
            <Label Text="xxSex" HorizontalExpand="True" StyleClasses="STFieldLabel" />
            <OptionButton Name="ProfileSex" HorizontalExpand="True" />
        </layout:VStack>

        <layout:VStack StyleClasses="STInsetBox">
            <Label Text="xxGender" HorizontalExpand="True" StyleClasses="STFieldLabel" />
            <OptionButton Name="ProfileGender" HorizontalExpand="True" />
        </layout:VStack>
    </layout:VStack>
</Control>
